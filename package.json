{
  "name": "@game-hub/game-cantstop",
  "version": "0.1.1",
  "type": "module",
  "description": "Can't Stop (Sid Sackson's push-your-luck dice game) as a Game Hub game package — built OUTSIDE the platform monorepo, against the published @game-hub/kernel and @game-hub/ui-kit, following the Labyrinth out-of-repo pilot (Track D). Four subpath exports over TypeScript source: ./engine (pure rules core), ./module (backend GameModule with the dice-roll route + bot runner), ./client (UI GameClient), ./bot (AI risk model + difficulty tiers + self-play).",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whtdrgn101/game-cantstop.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "files": [
    "dist"
  ],
  "exports": {
    "./engine": "./src/engine/index.ts",
    "./module": "./src/module/index.ts",
    "./client": "./src/client/index.ts",
    "./bot": "./src/bot/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./engine": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine/index.js"
      },
      "./module": {
        "types": "./dist/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./bot": {
        "types": "./dist/bot/index.d.ts",
        "default": "./dist/bot/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@game-hub/kernel": "^1.2.0",
    "@game-hub/ui-kit": "^1.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@game-hub/ui-kit": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@game-hub/kernel": "^1.3.0",
    "@game-hub/ui-kit": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fastify": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
